# LibreOffice / editor lock files
**/.~lock*
**/*~

# Font cache noise
**/.uuid

# Unused Noctalia v5 leftover
noctalia/.config/noctalia/luau-plugins/

# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo

# Secrets / local identity
noctalia/.config/noctalia/plugins/habitica/settings.json
noctalia/.config/noctalia/plugins/**/secrets.json
noctalia/.config/noctalia/plugins/**/*token*

# Large / local-only plugin noise (optional clipboard DB etc.)
noctalia/.config/noctalia/plugins/clipper/**/db/
noctalia/.config/noctalia/plugins/clipper/**/*.db
noctalia/.config/noctalia/plugins/clipper/**/history*

# Local plugin venvs / bytecode / backups
