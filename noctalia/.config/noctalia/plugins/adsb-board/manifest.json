{
  "id": "adsb-board",
  "name": "ADS-B Board",
  "version": "1.0.0",
  "minNoctaliaVersion": "4.6.6",
  "author": "ahmed",
  "license": "MIT",
  "description": "Aircraft near you via OpenSky (or local dump1090).",
  "tags": ["Desktop", "Aviation"],
  "entryPoints": {
    "desktopWidget": "DesktopWidget.qml"
  },
  "metadata": {
